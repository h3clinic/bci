  ;; Text annotations for top-level block diagram
  (text "NEURAL AFE HEADSTAGE - SYSTEM BLOCK DIAGRAM (Rev 2.0)\n\nConfiguration:\n  • 128 channels (2× RHD2164)\n  • fs = 30 kS/s per channel\n  • 16-bit resolution\n  • Throughput: 7.68 MB/s raw\n  • Egress: DDR SPI passthrough to carrier FPGA\n  • No MCU on headstage — pure analog front-end\n\nSignal Flow:\n  Electrodes → Inputs → AFE/ADC → SPI → B2B Connector → Carrier FPGA"
    (exclude_from_sim no)
    (at 25 25)
    (effects
      (font (size 1.5 1.5))
      (justify left)
    )
  )

  (text "POWER RAILS:\n  VIN: 3.3–5V (from carrier via B2B)\n  AVDD: 3.3V (low-noise LDO, analog)\n  DVDD_AFE: 3.3V (ferrite-filtered, RHD digital I/O)\n  VREF: 1.225V (internal to RHD2164)"
    (exclude_from_sim no)
